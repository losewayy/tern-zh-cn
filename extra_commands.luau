local registered = 0
for _, item in ipairs(commands) do
    local target = item[1]
    local title = item[2]
    local group = item[3]
    local command_id = "zh-extra-" .. tostring(registered + 1)
    tern.command({
        id = command_id,
        title = title,
        group = group,
        run = function(cx)
            cx:command(target)
        end,
    })
    registered += 1
end

return registered
